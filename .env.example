# Copy this file to .env and fill in your values. The real .env is gitignored.

# Bale bot token (required) — from @botfather in Bale.
BALE_TOKEN=123456789:abcd...your-token...

# Numeric user id of the admin. The admin is exempt from all rate limits.
# Leave empty/unset for no admin (everyone is limited).
ADMIN_USER_ID=
